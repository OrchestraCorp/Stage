STAGE_ENV=dev
STAGE_APP_NAME=orchestra-stage
# Local-only credentials match compose.yaml; production supplies its own URLs.
STAGE_DATABASE_URL=postgresql+asyncpg://stage:stage-dev-postgres@127.0.0.1:15432/stage
# SQLite is intended for local migration/tests only: sqlite+aiosqlite:///./stage.db
# Redis is auxiliary infrastructure; business facts and outbox stay in PostgreSQL.
# Core owns the configured client; optional by default, required when explicitly selected.
STAGE_REDIS_URL=redis://:stage-dev-redis@127.0.0.1:16379/0
STAGE_REDIS_CONNECT_TIMEOUT_SECONDS=2
STAGE_REDIS_SOCKET_TIMEOUT_SECONDS=2
STAGE_REDIS_MAX_CONNECTIONS=20
STAGE_REDIS_REQUIRED=false
STAGE_DATABASE_POOL_SIZE=5
STAGE_DATABASE_MAX_OVERFLOW=5
STAGE_DATABASE_POOL_TIMEOUT_SECONDS=2
STAGE_DEPENDENCY_PROBE_TIMEOUT_SECONDS=2
STAGE_DEPENDENCY_PROBE_INTERVAL_SECONDS=2
STAGE_RUNTIME_STARTUP_TIMEOUT_SECONDS=10
STAGE_RUNTIME_SHUTDOWN_TIMEOUT_SECONDS=10
STAGE_LOG_LEVEL=INFO
