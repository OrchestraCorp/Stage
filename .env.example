STAGE_ENV=dev
STAGE_APP_NAME=orchestra-stage
# Default production choice: MySQL 8+ via aiomysql.
STAGE_DATABASE_URL=mysql+aiomysql://stage:stage@127.0.0.1:3306/stage
# PostgreSQL alternative: postgresql+asyncpg://stage:stage@127.0.0.1:5432/stage
# SQLite is intended for local migration/tests only: sqlite+aiosqlite:///./stage.db
STAGE_LOG_LEVEL=INFO
